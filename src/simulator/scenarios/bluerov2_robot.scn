            <noise distance="0.0"/>
            <history samples="1"/>
            <origin xyz="0.178 0.0 0.112" rpy="0.0 0.0 0.0"/>
            <link name="vehicle"/>
            <ros_publisher topic="/heading_distance_ground_truth"/>
        </sensor> -->

