            <keypoint time="38.3281" xyz="24.2520 -1.0012 2.2998" rpy="0.0209 -0.0038 -0.0435"/>
            <keypoint time="40.9632" xyz="24.2261 -1.2682 2.2908" rpy="0.0159 -0.0139 -0.0401"/>
            <keypoint time="42.8548" xyz="24.0944 -1.5597 2.3117" rpy="0.0215 -0.0005 -0.0977"/>
            <keypoint time="44.7452" xyz="24.0400 -1.7634 2.2949" rpy="0.0213 -0.0029 -0.0877"/>
            <keypoint time="46.6378" xyz="24.0304 -1.9727 2.3107" rpy="0.0244 -0.0038 -0.0906"/>
            <keypoint time="48.4975" xyz="24.0414 -2.1837 2.3036" rpy="0.0188 -0.0028 -0.0838"/>
            <keypoint time="50.6532" xyz="24.0355 -2.3830 2.3098" rpy="0.0229 -0.0092 -0.0973"/>
            <keypoint time="53.1388" xyz="24.0004 -2.5899 2.3028" rpy="0.0155 -0.0075 -0.0908"/>
            <keypoint time="55.1957" xyz="23.9885 -2.7835 2.2994" rpy="0.0230 -0.0075 -0.1019"/>
            <keypoint time="57.0578" xyz="23.9538 -2.9613 2.3152" rpy="0.0313 0.0096 -0.1244"/>

        </trajectory>


    </animated>
</scenario>